---
import IslamicPattern from './IslamicPattern.astro';
---

<section class="hero" id="beranda">
  <IslamicPattern opacity={0.04} color="#2D7A4F" />

  <!-- Decorative blobs -->
  <div class="hero__blob hero__blob--green" aria-hidden="true"></div>
  <div class="hero__blob hero__blob--orange" aria-hidden="true"></div>

  <div class="hero__inner container">
    <!-- Left Column: Text -->
    <div class="hero__text">
      <span class="badge badge--green hero__badge reveal">
        🌙 Idul Adha 1447 H
      </span>

      <h1 class="hero__title reveal reveal-delay-1">
        Masjid Al-Hilal
      </h1>

      <p class="hero__tagline reveal reveal-delay-2">
        <em>"Berkurban, Bahagiakan Sesama"</em>
      </p>

      <p class="hero__sub reveal reveal-delay-2">
        Ranting Muhammadiyah Donorejo · Desa kecil dengan semangat besar
      </p>

      <div class="hero__actions reveal reveal-delay-3">
        <a href="#donasi" class="btn btn--primary">
          🐄 Daftar Qurban
        </a>
        <a href="#stats" class="btn btn--secondary">
          Lihat Pencapaian ↓
        </a>
      </div>
    </div>

    <!-- Right Column: Visual -->
    <div class="hero__visual reveal reveal-delay-2">
      <!-- Large decorative circle -->
      <div class="hero__circle hero__circle--outer" aria-hidden="true"></div>
      <div class="hero__circle hero__circle--inner" aria-hidden="true"></div>

      <!-- Central mosque SVG illustration -->
      <div class="hero__mosque-icon" aria-hidden="true">
        <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Crescent Moon -->
          <circle cx="100" cy="42" r="18" fill="#C4902A" opacity="0.85"/>
          <circle cx="108" cy="38" r="14" fill="#FAF6EF"/>
          <!-- Dome -->
          <path d="M60 120 Q100 60 140 120" fill="#2D7A4F" opacity="0.15"/>
          <path d="M65 120 Q100 65 135 120" fill="#2D7A4F" opacity="0.25"/>
          <!-- Main body -->
          <rect x="55" y="120" width="90" height="50" rx="4" fill="#2D7A4F" opacity="0.18"/>
          <!-- Door -->
          <rect x="87" y="140" width="26" height="30" rx="13" fill="#2D7A4F" opacity="0.3"/>
          <!-- Minarets -->
          <rect x="45" y="95" width="12" height="75" rx="3" fill="#2D7A4F" opacity="0.15"/>
          <rect x="143" y="95" width="12" height="75" rx="3" fill="#2D7A4F" opacity="0.15"/>
          <!-- Minaret caps -->
          <circle cx="51" cy="93" r="8" fill="#2D7A4F" opacity="0.12"/>
          <circle cx="149" cy="93" r="8" fill="#2D7A4F" opacity="0.12"/>
          <!-- Stars -->
          <circle cx="35" cy="55" r="2.5" fill="#C4902A" opacity="0.5"/>
          <circle cx="165" cy="48" r="2" fill="#C4902A" opacity="0.4"/>
          <circle cx="155" cy="70" r="1.5" fill="#C4902A" opacity="0.35"/>
          <circle cx="50" cy="35" r="1.8" fill="#C4902A" opacity="0.3"/>
        </svg>
      </div>

      <!-- Floating badge cards -->
      <div class="hero__floating-card hero__floating-card--top" aria-hidden="true">
        <span class="hero__floating-icon">🏆</span>
        <span class="hero__floating-text">4 Tahun Berturut-turut</span>
      </div>

      <div class="hero__floating-card hero__floating-card--bottom" aria-hidden="true">
        <span class="hero__floating-icon">🐄</span>
        <span class="hero__floating-text">10 Sapi · 🐑 13 Kambing</span>
      </div>

      <!-- Decorative leaf SVG -->
      <svg class="hero__leaf" viewBox="0 0 40 40" aria-hidden="true">
        <path d="M20 2 Q35 15 20 38 Q5 15 20 2Z" fill="#4CAF75" opacity="0.15"/>
        <line x1="20" y1="8" x2="20" y2="34" stroke="#4CAF75" stroke-width="0.8" opacity="0.2"/>
      </svg>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    padding-top: 64px; /* navbar height */
    background: var(--bg-base);
    background-image:
      radial-gradient(ellipse at 10% 90%, rgba(232, 245, 238, 0.6) 0%, transparent 50%),
      radial-gradient(ellipse at 90% 10%, rgba(253, 240, 230, 0.5) 0%, transparent 50%);
    overflow: hidden;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
    z-index: 1;
    padding-block: 3rem;
  }

  /* ---------- Blobs ---------- */
  .hero__blob {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    pointer-events: none;
    z-index: 0;
  }

  .hero__blob--green {
    width: 400px;
    height: 400px;
    background: var(--green-pale);
    left: -10%;
    bottom: -10%;
    opacity: 0.7;
  }

  .hero__blob--orange {
    width: 350px;
    height: 350px;
    background: var(--orange-pale);
    right: -5%;
    top: 5%;
    opacity: 0.6;
  }

  /* ---------- Text Column ---------- */
  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .hero__badge {
    align-self: flex-start;
    font-size: 0.82rem;
  }

  .hero__title {
    font-size: clamp(2.4rem, 7vw, 4.2rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .hero__tagline {
    font-size: clamp(1.1rem, 3vw, 1.4rem);
    color: var(--orange-primary);
    font-weight: 500;
  }

  .hero__sub {
    color: var(--text-muted);
    font-size: 0.95rem;
    margin-bottom: 0.5rem;
  }

  .hero__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  /* ---------- Visual Column ---------- */
  .hero__visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 420px;
  }

  .hero__circle {
    position: absolute;
    border-radius: 50%;
  }

  .hero__circle--outer {
    width: 380px;
    height: 380px;
    background: var(--orange-pale);
    opacity: 0.6;
  }

  .hero__circle--inner {
    width: 280px;
    height: 280px;
    background: var(--green-pale);
    opacity: 0.5;
  }

  .hero__mosque-icon {
    position: relative;
    z-index: 2;
    width: 220px;
    height: 220px;
    animation: float 4s ease-in-out infinite;
  }

  .hero__mosque-icon svg {
    width: 100%;
    height: 100%;
  }

  /* ---------- Floating Cards ---------- */
  .hero__floating-card {
    position: absolute;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.65rem 1rem;
    background: var(--bg-card);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--text-heading);
    white-space: nowrap;
  }

  .hero__floating-card--top {
    top: 15%;
    right: -5%;
    animation: float 3.5s ease-in-out infinite;
  }

  .hero__floating-card--bottom {
    bottom: 18%;
    left: -8%;
    animation: float 4.2s ease-in-out infinite 0.5s;
  }

  .hero__floating-icon {
    font-size: 1.1rem;
  }

  .hero__leaf {
    position: absolute;
    top: 8%;
    left: 5%;
    width: 36px;
    height: 36px;
    animation: float 5s ease-in-out infinite 1s;
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 900px) {
    .hero__inner {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 2rem;
    }

    .hero__text {
      align-items: center;
    }

    .hero__actions {
      justify-content: center;
    }

    .hero__visual {
      min-height: 320px;
    }

    .hero__circle--outer {
      width: 280px;
      height: 280px;
    }

    .hero__circle--inner {
      width: 200px;
      height: 200px;
    }

    .hero__mosque-icon {
      width: 180px;
      height: 180px;
    }

    .hero__floating-card--top {
      right: 5%;
    }

    .hero__floating-card--bottom {
      left: 5%;
    }
  }

  @media (max-width: 600px) {
    .hero {
      min-height: auto;
      padding-block: 5rem 3rem;
    }

    .hero__visual {
      min-height: 260px;
    }

    .hero__floating-card {
      font-size: 0.72rem;
      padding: 0.5rem 0.75rem;
    }
  }
</style>
