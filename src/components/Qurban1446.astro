<section class="qurban1446">
  <div class="container">
    <!-- Hero Banner -->
    <div class="q46__hero reveal">
      <div class="q46__hero-badge">
        <span class="q46__hero-year-label">Rekap Tahun Lalu</span>
      </div>
      <div class="q46__hero-content">
        <span class="badge badge--gold">📜 Arsip Qurban 1446H</span>
        <h1 class="q46__title">
          <span class="q46__title-emoji">🐄</span>
          Ajakan Qurban
          <span class="q46__title-emoji">🐏</span>
        </h1>
        <p class="q46__subtitle">Yuk Qurban di Masjid Al Hilal</p>
        <div class="q46__hadits">
          <p class="q46__hadits-text">
            <em>"Barangsiapa yang memiliki kelapangan (rizki) dan tidak berqurban, maka janganlah ia mendekati tempat shalat kami."</em>
          </p>
          <p class="q46__hadits-source">(HR. Ibnu Majah · Syaikh Al Albani: Hasan)</p>
        </div>
      </div>
      <div class="q46__hero-year">1446H</div>
    </div>

    <div class="ornamental-divider reveal"><span class="diamond"></span></div>

    <!-- Summary Stats -->
    <div class="q46__stats reveal">
      <div class="q46__stat">
        <span class="q46__stat-icon">🐄</span>
        <div class="q46__stat-info">
          <span class="q46__stat-number">{totalSapi}</span>
          <span class="q46__stat-label">Ekor Sapi</span>
        </div>
      </div>
      <div class="q46__stat-divider"></div>
      <div class="q46__stat">
        <span class="q46__stat-icon">🐐</span>
        <div class="q46__stat-info">
          <span class="q46__stat-number">{totalKambing}</span>
          <span class="q46__stat-label">Ekor Kambing</span>
        </div>
      </div>
      <div class="q46__stat-divider"></div>
      <div class="q46__stat">
        <span class="q46__stat-icon">👥</span>
        <div class="q46__stat-info">
          <span class="q46__stat-number">{totalPeserta}</span>
          <span class="q46__stat-label">Total Peserta</span>
        </div>
      </div>
      <div class="q46__stat-divider"></div>
      <div class="q46__stat">
        <span class="q46__stat-icon">✅</span>
        <div class="q46__stat-info">
          <span class="q46__stat-number">100%</span>
          <span class="q46__stat-label">Terlaksana</span>
        </div>
      </div>
    </div>

    <!-- Search & Filter -->
    <div class="q46__controls reveal">
      <div class="q46__search">
        <svg class="q46__search-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input
          type="text"
          id="q46Search"
          class="q46__search-input"
          placeholder="Cari nama peserta 1446H..."
          autocomplete="off"
        />
      </div>
      <div class="q46__filter-group">
        <button class="q46__filter-btn q46__filter-btn--active" data-filter="all">Semua</button>
        <button class="q46__filter-btn" data-filter="sapi">🐄 Sapi</button>
        <button class="q46__filter-btn" data-filter="kambing">🐐 Kambing</button>
      </div>
    </div>

    <!-- No Results -->
    <div class="q46__no-results" id="q46NoResults" style="display:none;">
      <span class="q46__no-results-icon">🔍</span>
      <p>Tidak ada peserta yang ditemukan</p>
    </div>

    <!-- Sapi Cards Grid -->
    <div class="q46__grid" id="q46Grid">
      {sapiGroups.map((group, idx) => (
        <div class="q46__card card reveal" data-type="sapi" style={`animation-delay: ${idx * 0.05}s`}>
          <div class="q46__card-top">
            <div class="q46__card-badge">
              <span class="q46__card-letter">{group.id}</span>
            </div>
            <div class="q46__card-info">
              <h3 class="q46__card-title">🐄 {group.label}</h3>
              <span class="q46__card-unit">{group.unit}</span>
            </div>
            {group.price && (
              <span class="q46__card-price">{group.price}</span>
            )}
