          </a>
        ))}
      </div>
    </div>

    <!-- Hashtags -->
    <div class="q46__hashtags reveal">
      <span class="q46__hashtag">#KamiSiap</span>
      <span class="q46__hashtag">#PanitiaAmanah</span>
      <span class="q46__hashtag">#LazismuDonorejo</span>
    </div>

    <!-- CTA to new year -->
    <div class="q46__cta reveal">
      <div class="q46__cta-inner">
        <span class="q46__cta-emoji">🕌</span>
        <h3 class="q46__cta-title">Qurban 1447H Sudah Dibuka!</h3>
        <p class="q46__cta-text">Alhamdulillah, program qurban 1446H telah terlaksana dengan baik. Ayo bergabung di program qurban tahun ini!</p>
        <a href="/" class="btn btn--primary">
          🐄 Lihat Program 1447H
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  // Search & Filter functionality for 1446H page
  const searchInput = document.getElementById('q46Search') as HTMLInputElement;
  const filterBtns = document.querySelectorAll('.q46__filter-btn');
  const grid = document.getElementById('q46Grid');
  const noResults = document.getElementById('q46NoResults');
  let currentFilter = 'all';

  function applyFilters() {
    if (!grid || !noResults) return;
    const query = searchInput?.value.toLowerCase().trim() || '';
    const cards = grid.querySelectorAll('.q46__card') as NodeListOf<HTMLElement>;
    let visibleCount = 0;

    cards.forEach(card => {
      const type = card.dataset.type || '';
      const matchesFilter = currentFilter === 'all' || type === currentFilter;

      if (!matchesFilter) {
        card.style.display = 'none';
        return;
      }

      if (!query) {
        card.style.display = '';
        visibleCount++;
        card.querySelectorAll('.q46__member').forEach(m => {
          (m as HTMLElement).style.display = '';
        });
        return;
      }

      const members = card.querySelectorAll('.q46__member');
      let cardHasMatch = false;
      members.forEach(m => {
        const name = m.querySelector('.q46__member-name')?.textContent?.toLowerCase() || '';
        if (name.includes(query)) {
          (m as HTMLElement).style.display = '';
          cardHasMatch = true;
        } else {
          (m as HTMLElement).style.display = 'none';
        }
      });

      const title = card.querySelector('.q46__card-title')?.textContent?.toLowerCase() || '';
      if (title.includes(query)) {
        cardHasMatch = true;
        members.forEach(m => {
          (m as HTMLElement).style.display = '';
        });
      }

      card.style.display = cardHasMatch ? '' : 'none';
      if (cardHasMatch) visibleCount++;
    });

    noResults.style.display = visibleCount === 0 ? 'flex' : 'none';
  }

  searchInput?.addEventListener('input', applyFilters);

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => b.classList.remove('q46__filter-btn--active'));
      btn.classList.add('q46__filter-btn--active');
      currentFilter = (btn as HTMLElement).dataset.filter || 'all';
      applyFilters();
    });
  });
</script>

<style>
  .qurban1446 {
    padding-top: calc(64px + 2rem);
    padding-bottom: 0;
    background: var(--bg-base);
    min-height: 100vh;
  }

  /* ===== Hero Banner ===== */
  .q46__hero {
    position: relative;
    background: linear-gradient(135deg, var(--green-primary) 0%, #1a5a36 50%, #0d3d24 100%);
    border-radius: var(--radius-lg);
    padding: clamp(2.5rem, 6vw, 4rem) clamp(2rem, 5vw, 3rem);
    text-align: center;
    overflow: hidden;
    margin-bottom: 1rem;
  }

  .q46__hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 20px 20px;
    pointer-events: none;
  }

  .q46__hero::after {
    content: '';
    position: absolute;
    top: -50%;
    right: -30%;
    width: 80%;
    height: 200%;
    background: radial-gradient(ellipse, rgba(196,144,42,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .q46__hero-badge {
    position: relative;
    z-index: 1;
    margin-bottom: 1.5rem;
  }

  .q46__hero-year-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 1rem;
    background: rgba(196, 144, 42, 0.2);
    border: 1px solid rgba(196, 144, 42, 0.3);
    border-radius: var(--radius-full);
    color: var(--gold);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .q46__hero-content {
    position: relative;
    z-index: 1;
  }

  .q46__hero-content .badge {
    margin-bottom: 1rem;
  }

  .q46__title {
    color: #fff;
    font-size: clamp(2rem, 6vw, 3.5rem);
    margin-bottom: 0.5rem;
    line-height: 1.15;
  }

  .q46__title-emoji {
    display: inline-block;
    animation: float 3s ease-in-out infinite;
  }

  .q46__title-emoji:last-child {
    animation-delay: 1.5s;
  }

  .q46__subtitle {
    color: rgba(255,255,255,0.75);
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    font-weight: 500;
    margin-bottom: 1.5rem;
  }

  .q46__hadits {
    max-width: 560px;
    margin-inline: auto;
    padding: 1.25rem 1.5rem;
    background: rgba(255,255,255,0.08);
    border-radius: var(--radius-md);
    border: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(4px);
  }

  .q46__hadits-text {
    color: rgba(255,255,255,0.85);
    font-size: clamp(0.85rem, 2vw, 0.95rem);
    line-height: 1.7;
    margin-bottom: 0.5rem;
  }

  .q46__hadits-source {
    color: rgba(255,255,255,0.45);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .q46__hero-year {
    position: absolute;
    bottom: -1rem;
    right: 1.5rem;
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: clamp(4rem, 12vw, 8rem);
    color: rgba(255,255,255,0.04);
    line-height: 1;
    z-index: 0;
    pointer-events: none;
  }

  /* ===== Stats ===== */
  .q46__stats {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
    padding: 1.25rem 2rem;
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    border: 1px solid var(--border);
    margin-bottom: 2rem;
    flex-wrap: wrap;
  }

  .q46__stat {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .q46__stat-icon {
    font-size: 1.8rem;
    line-height: 1;
  }

  .q46__stat-info {
    display: flex;
    flex-direction: column;
