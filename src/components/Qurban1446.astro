          <div class="q46__card-divider"></div>
          <ol class="q46__member-list">
            {group.members.map((member) => (
              <li class="q46__member">
                <span class="q46__member-check">✅</span>
                <span class="q46__member-name">{member}</span>
              </li>
            ))}
          </ol>
          <div class="q46__card-footer">
            <span class="q46__card-count">{group.members.length}/7 Peserta</span>
            <div class="q46__progress">
              <div class="q46__progress-bar" style={`width: ${(group.members.length / 7) * 100}%`}></div>
