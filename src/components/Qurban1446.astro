        <div class="q46__card-top">
          <div class="q46__card-badge q46__card-badge--kambing">
            <span class="q46__card-letter">🐐</span>
          </div>
          <div class="q46__card-info">
            <h3 class="q46__card-title">🐐 KAMBING</h3>
            <span class="q46__card-unit">Kambing Individual</span>
          </div>
          <span class="q46__card-count-badge">{kambingMembers.length} peserta</span>
        </div>
        <div class="q46__card-divider q46__card-divider--kambing"></div>
        <ol class="q46__member-list">
          {kambingMembers.map((member) => (
            <li class="q46__member">
              <span class="q46__member-check">✅</span>
              <span class="q46__member-name">{member}</span>
            </li>
          ))}
        </ol>
        <div class="q46__card-footer q46__card-footer--kambing">
          <span class="q46__card-count">{kambingMembers.length} Peserta Kambing</span>
          <span class="q46__status-badge q46__status-badge--kambing">✅ Lunas</span>
        </div>
      </div>
    </div>

    <!-- Payment Info -->
    <div class="q46__payment reveal">
      <div class="q46__payment-header">
        <h3>💳 Info Pembayaran</h3>
        <p>Pembayaran juga bisa melalui transfer</p>
      </div>
      <div class="q46__payment-body">
        <div class="q46__bank-card">
          <span class="q46__bank-logo">🏦</span>
          <div class="q46__bank-info">
            <span class="q46__bank-name">BSI (Bank Syariah Indonesia)</span>
            <span class="q46__bank-account">7777556589</span>
            <span class="q46__bank-holder">a.n Masjid Al Hilal</span>
          </div>
        </div>
        <p class="q46__payment-note">
          📎 Kirimkan bukti transfer ke panitia 🙏
        </p>
        <p class="q46__payment-ops">
          <strong>NB:</strong> Pembayaran qurban <span class="q46__highlight">+Rp.100.000</span> untuk Operasional
        </p>
      </div>
    </div>

    <!-- Contact Info -->
    <div class="q46__contact reveal">
      <h3 class="q46__contact-title">📞 Pendaftaran & Informasi</h3>
      <div class="q46__contact-grid">
        {contacts.map((c) => (
          <a href={`https://wa.me/${c.phone.replace(/[\s\-\+]/g, '')}`} class="q46__contact-card" target="_blank" rel="noopener">
            <span class="q46__contact-icon">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            </span>
            <div class="q46__contact-detail">
              <span class="q46__contact-name">{c.name}</span>
              <span class="q46__contact-phone">{c.phone}</span>
