---
/**
 * Donasi.astro — Section 6: Donasi & Pendaftaran
 */
const waContacts = [
  { name: 'Panitia Qurban', phone: '6281234567890', label: 'Hubungi Panitia' },
  { name: 'Bendahara', phone: '6281234567891', label: 'Konfirmasi Pembayaran' },
  { name: 'Ketua Ranting', phone: '6281234567892', label: 'Info Lebih Lanjut' },
];
---

<section class="donasi" id="donasi">
  <div class="container">
    <h2 class="section-title reveal">Pendaftaran & Donasi</h2>
    <p class="section-subtitle reveal reveal-delay-1">
      Daftarkan qurban Anda melalui transfer atau hubungi panitia via WhatsApp
    </p>
    <div class="ornamental-divider reveal"><span class="diamond"></span></div>

    <div class="donasi__grid">
      <!-- Kartu Rekening -->
      <div class="donasi__card card reveal reveal-delay-1">
        <div class="donasi__card-header">
          <span class="donasi__bank-icon">🏦</span>
          <div>
            <h3 class="donasi__card-title">Transfer Bank</h3>
            <p class="donasi__card-sub">Bank Syariah Indonesia (BSI)</p>
          </div>
        </div>

        <div class="donasi__account">
          <span class="donasi__account-label">Nomor Rekening</span>
          <span class="donasi__account-number" id="accountNumber">7777 556 589</span>
          <button class="donasi__copy-btn" id="copyBtn" aria-label="Salin nomor rekening">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"></path>
            </svg>
            Salin
          </button>
        </div>

        <div class="donasi__divider"></div>

        <div class="donasi__an">
          a.n. <strong>Panitia Qurban Al-Hilal Donorejo</strong>
        </div>

        <div class="donasi__qris">
          <div class="donasi__qris-placeholder">
            <span class="donasi__qris-icon">📱</span>
            <span class="donasi__qris-text">QRIS Tersedia</span>
            <span class="donasi__qris-sub">Scan untuk pembayaran digital</span>
          </div>
        </div>
      </div>

      <!-- Kartu WhatsApp -->
      <div class="donasi__card card reveal reveal-delay-2">
        <div class="donasi__card-header">
          <span class="donasi__bank-icon">💬</span>
          <div>
            <h3 class="donasi__card-title">Hubungi via WhatsApp</h3>
            <p class="donasi__card-sub">Klik untuk langsung terhubung</p>
          </div>
        </div>

        <div class="donasi__wa-list">
          {waContacts.map(contact => (
            <a
              href={`https://wa.me/${contact.phone}?text=Assalamualaikum, saya ingin mendaftar qurban Idul Adha 1447H di Masjid Al-Hilal.`}
              class="donasi__wa-btn"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="donasi__wa-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </span>
              <div class="donasi__wa-info">
                <span class="donasi__wa-name">{contact.name}</span>
                <span class="donasi__wa-label">{contact.label}</span>
              </div>
              <span class="donasi__wa-arrow">→</span>
            </a>
          ))}
        </div>

        <div class="donasi__address">
          <span class="donasi__address-icon">📍</span>
          <div>
            <strong>Masjid Al-Hilal Donorejo</strong>
            <p>Desa Donorejo, Kec. Donorejo, Pacitan, Jawa Timur</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Copy account number
  const copyBtn = document.getElementById('copyBtn');
  const accountNumber = document.getElementById('accountNumber');

  copyBtn?.addEventListener('click', async () => {
    const text = accountNumber?.textContent?.replace(/\s/g, '') || '';
    try {
      await navigator.clipboard.writeText(text);
      const original = copyBtn.innerHTML;
      copyBtn.innerHTML = '✓ Tersalin!';
      copyBtn.classList.add('donasi__copy-btn--copied');
      setTimeout(() => {
        copyBtn.innerHTML = original;
        copyBtn.classList.remove('donasi__copy-btn--copied');
      }, 2000);
    } catch {
      // fallback
      const area = document.createElement('textarea');
      area.value = text;
      document.body.appendChild(area);
      area.select();
      document.execCommand('copy');
      document.body.removeChild(area);
    }
  });
</script>

<style>
  .donasi {
    background: var(--bg-warm);
    padding: var(--section-padding);
  }

  .donasi__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .donasi__card {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .donasi__card-header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .donasi__bank-icon {
    font-size: 2rem;
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--green-pale);
    border-radius: var(--radius-sm);
    flex-shrink: 0;
  }

  .donasi__card-title {
    font-family: 'Playfair Display', serif;
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--text-heading);
  }

  .donasi__card-sub {
    color: var(--text-muted);
    font-size: 0.82rem;
  }

  /* Account */
  .donasi__account {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    padding: 1.25rem;
    background: var(--green-pale);
    border-radius: var(--radius-sm);
  }

  .donasi__account-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
  }

  .donasi__account-number {
    font-family: 'Playfair Display', serif;
    font-weight: 900;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    color: var(--green-primary);
    letter-spacing: 0.05em;
  }

  .donasi__copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--green-primary);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .donasi__copy-btn:hover {
    background: var(--green-primary);
    color: #fff;
  }

  .donasi__copy-btn--copied {
    background: var(--green-primary);
    color: #fff;
  }

  .donasi__divider {
    height: 1px;
    background: var(--border);
  }

  .donasi__an {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .donasi__an strong {
    color: var(--text-heading);
  }

  /* QRIS */
  .donasi__qris-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    padding: 2rem;
    border: 2px dashed var(--green-light);
    border-radius: var(--radius-sm);
    background: var(--green-pale);
  }

  .donasi__qris-icon {
    font-size: 2rem;
  }

  .donasi__qris-text {
    font-weight: 700;
    color: var(--green-primary);
    font-size: 0.9rem;
  }

  .donasi__qris-sub {
    color: var(--text-muted);
    font-size: 0.78rem;
  }

  /* WhatsApp buttons */
  .donasi__wa-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .donasi__wa-btn {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.85rem 1.1rem;
    background: var(--green-pale);
    border: 1px solid rgba(45, 122, 79, 0.2);
    border-radius: var(--radius-sm);
    transition: all 0.3s ease;
    text-decoration: none;
  }

  .donasi__wa-btn:hover {
    background: var(--green-primary);
    color: #fff;
    transform: translateX(4px);
  }

  .donasi__wa-btn:hover .donasi__wa-icon {
    background: rgba(255,255,255,0.2);
    color: #fff;
  }

  .donasi__wa-btn:hover .donasi__wa-name,
  .donasi__wa-btn:hover .donasi__wa-label {
    color: #fff;
  }

  .donasi__wa-btn:hover .donasi__wa-arrow {
    color: #fff;
  }

  .donasi__wa-icon {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--green-primary);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    transition: all 0.3s ease;
  }

  .donasi__wa-info {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .donasi__wa-name {
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--text-heading);
    transition: color 0.3s ease;
  }

  .donasi__wa-label {
    font-size: 0.78rem;
    color: var(--text-muted);
    transition: color 0.3s ease;
  }

  .donasi__wa-arrow {
    font-size: 1.1rem;
    color: var(--green-primary);
    font-weight: 700;
    transition: all 0.3s ease;
  }

  /* Address */
  .donasi__address {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    background: var(--orange-pale);
    border: 1px solid rgba(224, 120, 64, 0.2);
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
  }

  .donasi__address-icon {
    font-size: 1.3rem;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .donasi__address strong {
    color: var(--text-heading);
    display: block;
    margin-bottom: 0.15rem;
  }

  .donasi__address p {
    color: var(--text-muted);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  @media (max-width: 600px) {
    .donasi__grid {
      grid-template-columns: 1fr;
    }

    .donasi__card {
      padding: 1.5rem;
    }
  }
</style>
