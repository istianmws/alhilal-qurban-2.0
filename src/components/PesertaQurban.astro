---

<section class="peserta" id="peserta">
  <div class="container">
    <!-- Header -->
    <div class="peserta__header reveal">
      <span class="badge badge--green">🐄 Ajakan Qurban 🐏</span>
      <h2 class="section-title">Daftar Peserta Qurban</h2>
      <p class="peserta__ayat">
        <em>"Maka dirikanlah salat karena Tuhanmu; dan berqurbanlah."</em>
      </p>
      <p class="peserta__ayat-ref">(Q.S Al-Kautsar : 2)</p>
      <p class="section-subtitle">
        Yuk Qurban di Masjid Al Hilal — Berikut adalah list calon mudhohi di Masjid Al Hilal 1447 H
      </p>
    </div>
    <div class="ornamental-divider reveal"><span class="diamond"></span></div>

    <!-- Summary Stats -->
