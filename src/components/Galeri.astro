---
/**
 * Galeri.astro — Section 7: Galeri Dokumentasi
 */
const galleryItems = [
  { label: 'Penyembelihan Qurban 1446H', span: true },
  { label: 'Pembagian Daging', span: false },
  { label: 'Kebersamaan Jamaah', span: false },
  { label: 'Persiapan Panitia', span: false },
  { label: 'Suasana Hari Raya', span: false },
];
---

<section class="galeri" id="galeri">
  <div class="container">
    <h2 class="section-title reveal">Galeri Dokumentasi</h2>
    <p class="section-subtitle reveal reveal-delay-1">
      Momen-momen berkesan dari program qurban tahun-tahun sebelumnya
    </p>
    <div class="ornamental-divider reveal"><span class="diamond"></span></div>

    <div class="galeri__grid">
      {galleryItems.map((item, i) => (
        <div
          class={`galeri__item card reveal reveal-delay-${Math.min(i + 1, 4)} ${item.span ? 'galeri__item--span' : ''}`}
        >
          <div class="galeri__placeholder">
            <svg class="galeri__placeholder-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"/>
              <circle cx="8.5" cy="8.5" r="1.5"/>
              <polyline points="21 15 16 10 5 21"/>
            </svg>
            <span class="galeri__placeholder-text">Foto Dokumentasi</span>
          </div>
          <div class="galeri__label">{item.label}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .galeri {
    background: var(--bg-base);
    padding: var(--section-padding);
  }

  .galeri__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  .galeri__item {
    overflow: hidden;
    position: relative;
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .galeri__item--span {
    grid-column: span 2;
  }

  .galeri__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 3rem 2rem;
    background: linear-gradient(135deg, var(--bg-warm), var(--bg-card));
    min-height: 200px;
  }

  .galeri__item--span .galeri__placeholder {
    min-height: 260px;
  }

  .galeri__placeholder-icon {
    width: 40px;
    height: 40px;
    color: var(--text-muted);
    opacity: 0.5;
  }

  .galeri__placeholder-text {
    color: var(--text-muted);
    font-size: 0.82rem;
    font-weight: 500;
  }

  .galeri__label {
    padding: 0.85rem 1.1rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text-heading);
    background: var(--bg-card);
  }

  @media (max-width: 900px) {
    .galeri__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .galeri__item--span {
      grid-column: span 2;
    }
  }

  @media (max-width: 600px) {
    .galeri__grid {
      grid-template-columns: 1fr;
    }

    .galeri__item--span {
      grid-column: span 1;
    }

    .galeri__placeholder {
      min-height: 160px;
    }

    .galeri__item--span .galeri__placeholder {
      min-height: 180px;
    }
  }
</style>
